<?xml version="1.0" encoding="utf-8"?>
<!-- Botón secundario con borde: se reconoce como botón (antes era texto sin forma). Colores fijos, sin ?attr, por API 21. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#FAFAFA" /><stroke android:width="1dp" android:color="#BDBDBD" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#E5E5E5" /><stroke android:width="1dp" android:color="#333333" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#EEEEEE" /><stroke android:width="2dp" android:color="#333333" /><corners android:radius="8dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#FFFFFF" /><stroke android:width="1dp" android:color="#555555" /><corners android:radius="8dp" /></shape>
    </item>
</selector>
