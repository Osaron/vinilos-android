<?xml version="1.0" encoding="utf-8"?>
<!-- #80: Seleccionar coleccionista (HU09 y HU10). Reutiliza la tarjeta y los estados del listado de HU05. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="Overdraw"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="#FAFAFA" android:focusable="true" android:focusableInTouchMode="true">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:accessibilityHeading="true" tools:targetApi="p"
        android:text="@string/active_collector_title" android:textSize="24sp" android:textColor="#222222" android:paddingBottom="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/active_collector_help" android:textColor="#555555" android:paddingBottom="8dp" />
    <TextView android:id="@+id/current_active_collector" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#333333" android:textStyle="bold" android:paddingBottom="12dp" android:accessibilityLiveRegion="polite" />
    <EditText android:id="@+id/search_active_collector" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:background="@drawable/search_background" android:paddingStart="20dp" android:paddingEnd="20dp"
        android:hint="@string/search_collectors" android:textColorHint="#666666" android:inputType="text" android:imeOptions="actionSearch" android:maxLines="1" android:autofillHints="" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="12dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/active_collector_list" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ProgressBar android:id="@+id/loading_active_collectors" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="center" android:contentDescription="@string/loading_collectors" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/active_collector_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:padding="16dp" android:textColor="#333333" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <Button android:id="@+id/retry_active_collectors" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/retry" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
