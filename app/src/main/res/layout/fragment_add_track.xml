<?xml version="1.0" encoding="utf-8"?>
<!-- HU08 (#31): selección del álbum arriba y formulario de la canción (#32) debajo.
     #34: entre ambos, el estado del envío (guardando, error o aviso) y "Ver álbum". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="Overdraw"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/album_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <TextView
            style="@style/Vinilos.FormLabel"
            android:accessibilityHeading="true" tools:targetApi="p"
            android:text="@string/add_track_album_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/selected_album"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textColor="#222222"
                android:textSize="18sp" />

            <ProgressBar
                android:id="@+id/album_loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/add_track_loading_albums"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/album_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingTop="4dp"
            android:textColor="#B00020"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/change_album_button"
                style="@style/Vinilos.SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/add_track_change_album"
                android:visibility="gone" />

            <Button
                android:id="@+id/retry_albums_button"
                style="@style/Vinilos.SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/retry"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/save_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ProgressBar
            android:id="@+id/saving_indicator"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/add_track_saving"
            android:visibility="gone" />

        <TextView
            android:id="@+id/track_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#222222"
            android:visibility="gone" />

        <Button
            android:id="@+id/view_album_button"
            style="@style/Vinilos.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/add_track_view_album"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/track_form_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
