<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="#FAFAFA" android:focusable="true" android:focusableInTouchMode="true">
    <Button android:id="@+id/back_to_albums" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/back_to_albums" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/artists" android:textSize="24sp" android:textColor="#222222" android:paddingBottom="16dp" />
    <EditText android:id="@+id/search_artists" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:background="@drawable/search_background" android:paddingStart="20dp" android:paddingEnd="20dp"
        android:hint="@string/search_artists" android:inputType="text" android:imeOptions="actionSearch" android:maxLines="1" android:autofillHints="" />
    <TextView android:id="@+id/artist_count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="12dp" android:paddingBottom="12dp" android:textColor="#555555" />
    <TextView android:id="@+id/artist_selection" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingBottom="8dp" android:textColor="#333333" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/artist_list" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ProgressBar android:id="@+id/loading_artists" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="center" android:contentDescription="@string/loading_artists" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/artist_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:padding="16dp" android:textColor="#333333" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <Button android:id="@+id/retry_artists" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/retry" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
