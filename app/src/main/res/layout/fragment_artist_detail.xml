<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <ScrollView
        android:id="@+id/artist_detail_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/back_artist_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/back" />

            <ImageView
                android:id="@+id/artist_detail_image"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="@drawable/artist_image_background"
                android:contentDescription="@string/artist_image_loading"
                android:clipToOutline="true"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/artist_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                tools:targetApi="p"
                android:gravity="center"
                android:paddingTop="12dp"
                android:textColor="#222222"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/artist_detail_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="4dp"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/artist_detail_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="4dp"
                android:textColor="#555555" />

            <!-- HU10 (#87, #89): agregar a los favoritos del coleccionista activo. Estado en texto, sin indicador animado. -->
            <Button
                android:id="@+id/add_favorite_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="@string/favorite_add" />

            <TextView
                android:id="@+id/favorite_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:paddingTop="4dp"
                android:textColor="#333333" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Uno debajo del otro: lado a lado no caben en pantallas de 320dp ni con fuente grande. -->
                <Button
                    android:id="@+id/change_favorite_collector"
                    style="@style/Vinilos.SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/favorite_change_collector" />

                <Button
                    android:id="@+id/view_my_favorites_button"
                    style="@style/Vinilos.SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/favorite_view_mine"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                tools:targetApi="p"
                android:paddingTop="24dp"
                android:text="@string/artist_biography"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/artist_detail_biography"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textColor="#555555"
                android:textSize="16sp" />

            <LinearLayout android:id="@+id/band_members_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/hu12_members" android:textStyle="bold"
                    android:textSize="18sp" android:paddingTop="16dp" />
                <TextView android:id="@+id/band_members"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="8dp" android:accessibilityLiveRegion="polite" />
                <TextView android:id="@+id/band_association_status"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/hu12_saved" android:visibility="gone"
                    android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/add_band_musician"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:visibility="gone" android:text="@string/hu12_choose" />
            </LinearLayout>

            <!-- HU14: premios del artista y acción para asignar uno (requiere coleccionista activo) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                tools:targetApi="p"
                android:paddingTop="24dp"
                android:text="@string/hu14_prizes"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/artist_detail_prizes_message"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="8dp" android:textColor="#555555" android:textSize="16sp"
                android:text="@string/hu14_prizes_loading" />
            <LinearLayout android:id="@+id/artist_detail_prizes"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView android:id="@+id/artist_detail_prize_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="8dp" android:textColor="#333333" android:text="@string/hu14_saved"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <Button android:id="@+id/add_artist_prize" style="@style/Vinilos.SecondaryButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/hu14_open" android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    tools:targetApi="p"
                    android:text="@string/artist_albums"
                    android:textColor="#222222"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/artist_album_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#333333" />
            </LinearLayout>

            <!-- HU15: agregar un álbum del catálogo a la discografía (requiere coleccionista activo) -->
            <TextView android:id="@+id/artist_detail_album_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="8dp" android:textColor="#333333" android:text="@string/hu15_saved"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <Button android:id="@+id/add_artist_album" style="@style/Vinilos.SecondaryButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/hu15_open" android:visibility="gone" />

            <LinearLayout
                android:id="@+id/artist_detail_albums"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="24dp" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/artist_detail_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:contentDescription="@string/loading_artist_detail" />

    <LinearLayout
        android:id="@+id/artist_detail_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/artist_detail_error"
            android:textColor="#333333" />

        <Button
            android:id="@+id/retry_artist_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/retry" />
    </LinearLayout>
</FrameLayout>
