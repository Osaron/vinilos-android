<?xml version="1.0" encoding="utf-8"?>
<!-- HU14: asignar un premio existente, con fecha, a un músico o una banda. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FAFAFA" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <Button android:id="@+id/assign_prize_cancel" style="@style/Vinilos.SecondaryButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/back" />
        <TextView android:id="@+id/assign_prize_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp" android:text="@string/hu14_title"
            android:textColor="#222222" android:textSize="24sp"
            android:accessibilityHeading="true" tools:targetApi="p" />
        <TextView android:id="@+id/assign_prize_context"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:textColor="#333333" />

        <TextView style="@style/Vinilos.FormLabel" android:text="@string/hu14_prize_label"
            android:accessibilityHeading="true" tools:targetApi="p" />
        <ProgressBar android:id="@+id/assign_prize_loading"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginTop="12dp" android:contentDescription="@string/hu14_loading" />
        <Button android:id="@+id/assign_prize_retry" style="@style/Vinilos.SecondaryButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/hu14_retry" android:visibility="gone" />
        <TextView android:id="@+id/assign_prize_empty"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:textColor="#333333" android:text="@string/hu14_empty"
            android:accessibilityLiveRegion="polite" android:visibility="gone" />
        <RadioGroup android:id="@+id/assign_prize_options"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" />

        <TextView style="@style/Vinilos.FormLabel" android:text="@string/hu14_date_label"
            android:accessibilityHeading="true" tools:targetApi="p" />
        <TextView android:id="@+id/assign_prize_date"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="4dp" android:textColor="#222222" android:text="@string/hu14_date_none"
            android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/assign_prize_pick_date" style="@style/Vinilos.SecondaryButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/hu14_date_choose" />

        <TextView android:id="@+id/assign_prize_status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp" android:textColor="#333333"
            android:accessibilityLiveRegion="polite" android:visibility="gone" />
        <Button android:id="@+id/assign_prize_confirm"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:minHeight="48dp"
            android:enabled="false" android:text="@string/hu14_assign" />
    </LinearLayout>
</ScrollView>
