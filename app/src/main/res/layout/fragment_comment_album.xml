<?xml version="1.0" encoding="utf-8"?>
<!-- HU09 (#82, #83): comentar un álbum. Errores en TextView propios, visibles sin foco y legibles
     por TalkBack, como en el formulario de HU07. Sin indicador animado: el estado se muestra en texto. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FAFAFA" android:fillViewport="true"
    tools:ignore="Overdraw">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/comment_title" android:textSize="24sp" android:textColor="#222222"
            android:paddingTop="12dp" android:paddingBottom="4dp"
            android:accessibilityHeading="true" tools:targetApi="p" />

        <TextView android:id="@+id/comment_album_context" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#555555" android:paddingBottom="8dp"
            android:visibility="gone" />

        <!-- Coleccionista activo (#80) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/comment_collector" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#333333" android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/change_comment_collector" style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/comment_change_collector" />
        </LinearLayout>
        <TextView android:id="@+id/comment_collector_error" style="@style/Vinilos.FormError"
            android:text="@string/comment_collector_error" />

        <!-- Comentario -->
        <TextView style="@style/Vinilos.FormLabel" android:labelFor="@+id/comment_input"
            android:text="@string/comment_label" />
        <EditText android:id="@+id/comment_input" style="@style/Vinilos.FormInput"
            android:minLines="3" android:gravity="top|start" android:maxLength="500"
            android:inputType="textMultiLine|textCapSentences" android:autofillHints="" />
        <TextView android:id="@+id/comment_description_error" style="@style/Vinilos.FormError"
            android:text="@string/comment_description_error" />

        <!-- Calificación de 1 a 5 -->
        <TextView android:id="@+id/comment_rating_label" style="@style/Vinilos.FormLabel"
            android:text="@string/comment_rating_label" />
        <RadioGroup android:id="@+id/rating_group" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rating_1" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/rating_1"
                android:contentDescription="@string/rating_1_description" />
            <RadioButton android:id="@+id/rating_2" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/rating_2"
                android:contentDescription="@string/rating_2_description" />
            <RadioButton android:id="@+id/rating_3" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/rating_3"
                android:contentDescription="@string/rating_3_description" />
            <RadioButton android:id="@+id/rating_4" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/rating_4"
                android:contentDescription="@string/rating_4_description" />
            <RadioButton android:id="@+id/rating_5" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/rating_5"
                android:contentDescription="@string/rating_5_description" />
        </RadioGroup>
        <TextView android:id="@+id/comment_rating_error" style="@style/Vinilos.FormError"
            android:text="@string/comment_rating_error" />

        <!-- Estado del envío -->
        <TextView android:id="@+id/comment_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="16dp"
            android:accessibilityLiveRegion="polite" android:visibility="gone" />
        <Button android:id="@+id/view_commented_album_button" style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/comment_view_album" android:visibility="gone" />

        <Button android:id="@+id/publish_comment_button" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:minHeight="48dp" android:text="@string/comment_publish" />
        <Button android:id="@+id/cancel_comment_button" style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/comment_cancel" />
    </LinearLayout>
</ScrollView>
