<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FAFAFA" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/track_form_title" android:textSize="24sp" android:textColor="#222222"
            android:paddingTop="12dp" android:paddingBottom="16dp" />
        <TextView style="@style/Vinilos.FormLabel" android:labelFor="@+id/track_name_input"
            android:text="@string/track_name_label" />
        <EditText android:id="@+id/track_name_input" style="@style/Vinilos.FormInput"
            android:inputType="textCapSentences" android:autofillHints="" />
        <TextView android:id="@+id/track_name_error" style="@style/Vinilos.FormError"
            android:text="@string/track_name_error" android:accessibilityLiveRegion="polite" />
        <TextView style="@style/Vinilos.FormLabel" android:labelFor="@+id/track_duration_input"
            android:text="@string/track_duration_label" />
        <EditText android:id="@+id/track_duration_input" style="@style/Vinilos.FormInput"
            android:inputType="text" android:hint="@string/track_duration_hint" android:autofillHints="" />
        <TextView android:id="@+id/track_duration_error" style="@style/Vinilos.FormError"
            android:text="@string/track_duration_error" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/track_save_button" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:minHeight="48dp" android:text="@string/track_save" />
    </LinearLayout>
</ScrollView>
