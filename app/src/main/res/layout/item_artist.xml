<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    android:minHeight="80dp" android:padding="12dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/card_background" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/artist_image" android:layout_width="56dp" android:layout_height="56dp"
        android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/artist_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#222222" />
        <TextView android:id="@+id/artist_type" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="4dp" android:textColor="#555555" />
    </LinearLayout>
</LinearLayout>
