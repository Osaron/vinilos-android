<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: la app no guarda datos del usuario; se excluye todo de la copia en la nube y
     de la transferencia entre dispositivos, igual que allowBackup="false" en versiones anteriores. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
